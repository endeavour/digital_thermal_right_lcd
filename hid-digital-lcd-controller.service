[Unit]
Description=Digital LCD Controller for Thermalright CPU Cooler
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=@out@/bin/hid-digital-lcd-controller @out@/share/hid-digital-lcd-controller/config.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment variables for device access
Environment=CPPFLAGS="-I@libdrm@/include -I@linuxHeaders@/include/drm -I@libdrm@/include/libdrm"
Environment=C_INCLUDE_PATH="@libdrm@/include:@linuxHeaders@/include:$C_INCLUDE_PATH"
Environment=CPLUS_INCLUDE_PATH="@libdrm@/include:@linuxHeaders@/include:$CPLUS_INCLUDE_PATH"
Environment=PKG_CONFIG_PATH="@libdrm@/lib/pkgconfig:$PKG_CONFIG_PATH"
Environment=LD_LIBRARY_PATH="@cc@/lib:@glibc@/lib:@zlib@/lib:@hidapi@/lib:$LD_LIBRARY_PATH"

[Install]
WantedBy=multi-user.target